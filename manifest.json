{
  "manifest_version": 3,
  "name": "Betaal",
  "version": "0.1.0",
  "description": "Privacy-preserving vision agent",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Betaal"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extension/action-executor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}