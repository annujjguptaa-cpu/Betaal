{
  "manifest_version": 3,
  "name": "Betaal",
  "version": "0.1.0",
  "description": "Privacy-preserving vision agent",
  "browser_specific_settings": {
    "gecko": {
      "id": "betaal@yourteam.dev",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "scripts": [
      "extension/browser-polyfill.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Betaal"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extension/browser-polyfill.js",
        "extension/action-executor.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
